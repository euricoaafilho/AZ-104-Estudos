#!/bin/bash

# --- Configurações Iniciais para Global VNet Peering ---
RESOURCE_GROUP_NAME="rg-global-peering-demo"
LOCATION_A="eastus"  # Primeira região
LOCATION_B="westus"  # Segunda região (diferente da primeira)

VNET_A_NAME="vnet-global-a"
VNET_A_PREFIX="10.0.0.0/16"

VNET_B_NAME="vnet-global-b"
VNET_B_PREFIX="10.1.0.0/16"

PEERING_AB_NAME="vnet-global-a-to-b"
PEERING_BA_NAME="vnet-global-b-to-a"

echo "--- Criando Grupo de Recursos: $RESOURCE_GROUP_NAME em $LOCATION_A ---"
az group create --name $RESOURCE_GROUP_NAME --location $LOCATION_A

echo "--- Criando VNet A: $VNET_A_NAME em $LOCATION_A com prefixo $VNET_A_PREFIX ---"
az network vnet create \
    --name $VNET_A_NAME \
    --resource-group $RESOURCE_GROUP_NAME \
    --location $LOCATION_A \
    --address-prefix $VNET_A_PREFIX

echo "--- Criando VNet B: $VNET_B_NAME em $LOCATION_B com prefixo $VNET_B_PREFIX ---"
az network vnet create \
    --name $VNET_B_NAME \
    --resource-group $RESOURCE_GROUP_NAME \
    --location $LOCATION_B \
    --address-prefix $VNET_B_PREFIX

echo "--- Criando Peering de $VNET_A_NAME para $VNET_B_NAME ---"
az network vnet peering create \
    --name $PEERING_AB_NAME \
    --resource-group $RESOURCE_GROUP_NAME \
    --vnet-name $VNET_A_NAME \
    --remote-vnet $VNET_B_NAME \
    --allow-vnet-access

echo "--- Criando Peering de $VNET_B_NAME para $VNET_A_NAME ---"
az network vnet peering create \
    --name $PEERING_BA_NAME \
    --resource-group $RESOURCE_GROUP_NAME \
    --vnet-name $VNET_B_NAME \
    --remote-vnet $VNET_A_NAME \
    --allow-vnet-access

echo "--- Verificando o status do Peering ---"
echo "Peering de $VNET_A_NAME para $VNET_B_NAME:"
az network vnet peering show \
    --name $PEERING_AB_NAME \
    --resource-group $RESOURCE_GROUP_NAME \
    --vnet-name $VNET_A_NAME \
    --query peeringState -o tsv

echo "Peering de $VNET_B_NAME para $VNET_A_NAME:"
az network vnet peering show \
    --name $PEERING_BA_NAME \
    --resource-group $RESOURCE_GROUP_NAME \
    --vnet-name $VNET_B_NAME \
    --query peeringState -o tsv

echo "--- Global VNet Peering configurado com sucesso! ---"
echo "Para testar, você pode criar VMs em cada VNet e tentar pingar uma à outra."