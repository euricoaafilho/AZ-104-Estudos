# -----------------------------------------------------------------------------
# Script: 02-azure-vpn-gateway.azcli
# Descrição: Cria o Virtual Network Gateway (VPN Gateway) no Azure para a VPN Site-to-Site.
#            Este gateway será do tipo VPN, SKU VpnGw1, e usará o tipo de VPN RouteBased.
# -----------------------------------------------------------------------------

# --- Configurações Iniciais (devem ser as mesmas do script 01) ---
rg_name="rg-vpn-s2s"
location="eastus"
vnet_name="vnet-s2s"
vpn_gateway_name="vnet-s2s-gw" # Nome do seu VPN Gateway para S2S
public_ip_name="vnet-s2s-gw-pip" # Nome do IP Público para o Gateway S2S

echo "Iniciando a criação do VPN Gateway para Site-to-Site..."

# 1. Criar um Endereço IP Público para o VPN Gateway
# O VPN Gateway precisa de um IP público para ser acessível pelo dispositivo VPN local.
echo "Criando o IP Público: $public_ip_name..."
az network public-ip create \
    --resource-group $rg_name \
    --name $public_ip_name \
    --location $location \
    --allocation-method Dynamic \
    --sku Basic \
    --output none

# 2. Criar o Virtual Network Gateway (VPN Gateway)
# Este é o componente principal para a conectividade VPN Site-to-Site.
# - --gateway-type Vpn: Indica que é um gateway VPN.
# - --vpn-type RouteBased: Essencial para S2S e para cenários mais avançados com BGP.
# - --sku VpnGw1: Um SKU mais robusto que o Basic, recomendado para S2S.
#                 Para produção, considere SKUs maiores como VpnGw2, VpnGw3, etc.
# - --no-wait: Permite que o script continue sem esperar a conclusão da criação do gateway,
#              que pode levar de 30 a 45 minutos.
echo "Criando o VPN Gateway: $vpn_gateway_name (isso pode levar de 30 a 45 minutos)..."
az network vnet-gateway create \
    --resource-group $rg_name \
    --name $vpn_gateway_name \
    --location $location \
    --public-ip-address $public_ip_name \
    --vnet $vnet_name \
    --gateway-type Vpn \
    --vpn-type RouteBased \
    --sku VpnGw1 \
    --no-wait \
    --output none

echo "Comando para criação do VPN Gateway Site-to-Site enviado. A criação pode levar um tempo considerável."
echo "Você pode verificar o status da criação com: az network vnet-gateway show -g $rg_name -n $vpn_gateway_name -o table"